# ==============================================================
# ビルド成果物 / IDE の作業ファイル
# ==============================================================

# Visual Studio
.vs/

# C++ のビルド出力 (各プロジェクトの x64/Debug, x64/Release と中間ファイル)
x64/
Win32/

# C# のビルド出力
bin/
obj/

# 一時ファイル
*.tmp
*.log
*.tlog
*.ipch
*.aps

# Claude の作業用一時スクリプト
ClaudLog/_tmp_*

# テクスチャの DDS キャッシュ (初回読み込み時に自動生成。例: grass.jpg.v1.dds)
*.v[0-9]*.dds

# ==============================================================
# エディターのプロジェクト (ED5)
#   Assets のモデル / テクスチャ / 音の本体は git に入れない (見本のモデルは Project/Assets/Models にだけ置く。以前は bin/.../Model に元があり、エディターが写した)
#   .meta (アセットの Id) / シーン / マテリアルは入れる
# ==============================================================
CSharp_console/Project/Assets/**/*.*
!CSharp_console/Project/Assets/**/*.meta
!CSharp_console/Project/Assets/**/*.scene.json
!CSharp_console/Project/Assets/**/*.material.json
# プレハブも入れる (ED8 後半で気付いた。以前は *.prefab.json が上の行で外れ、git に入らなかった)
!CSharp_console/Project/Assets/**/*.prefab.json
# 自分のシェーダー (SH2) と、雲のノイズのテクスチャ (SH3。ユーザーが用意した物。小さいので入れる)
!CSharp_console/Project/Assets/**/*.hlsl
# シェーダーグラフも入れる (SH4)
!CSharp_console/Project/Assets/**/*.shadergraph.json
# 自作の FBX のサンプル (AN1。Assets > Create FBX Samples で作り直せる)
!CSharp_console/Project/Assets/Samples/Fbx/*.fbx
!CSharp_console/Project/Assets/Textures/Noise/*.png
!CSharp_console/Project/Assets/Textures/Noise/*.jpg
CSharp_console/Project/Library/
# 書き出したゲーム (ED8 後半。File > Build Game の既定の書き出し先)
CSharp_console/Project/Build/
# 雲の参考資料 (CEDEC の発表資料。大きく、他の方の物なので入れない。SH1 の時に決めた)
CSharp_console/GameEngine.Editor/assets/*.pptx

# ==============================================================
# Package (Tools/make_package.py が作る。外部の PC へ持っていく、ビルドした物と .NET の集まり。git には入れない)
# ==============================================================
/Package/
# ゲームのコード (v1.1。Project の Create > Scripts > Behaviour で Assets に作る .cs) は入れる
!CSharp_console/Project/Assets/**/*.cs
# エディターがダブルクリックで作る sln (v1.1。いつでも作り直せる)
CSharp_console/Project/*.sln
!CSharp_console/Project/Assets/Samples/Fbx/*_Materials/*.bmp
