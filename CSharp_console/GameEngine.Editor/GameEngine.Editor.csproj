<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ==========================================================================
    エディター (ED3)。GUI でシーン / エンティティ / コンポーネントを操作する
      - GUI は ImGui (ImGui.NET。docking 版)。描画はエンジンの RHI (Renderer.dll の UI の描画) で行う
      - シーンは編集中は動かさない (物理 / 音 / ゲームの System は再生 (ED4) の時だけ)
      - ゲームのコード (Project/Scripts の Game.csproj) は参照しない。エディターがビルドして読み込み、読み直す (ED7)
    ==========================================================================
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>GameEngine.Editor</RootNamespace>
    <!--
      ED7 : ゲームの DLL を読み直した時に、古い DLL が解放されるように、ループのあるメソッドも最初から最適化して JIT する。
      既定 (true) では、ループのあるメソッドを軽い JIT で始めて後から JIT し直すが、そうすると
      エンジンのジェネリックなメソッドをゲームの型で使った物 (World.ForEach<Transform, Spin> など) を再生で動かした後、
      古い DLL がいつまでも解放されなかった (調べた結果 : TieredCompilation=0 と TC_QuickJitForLoops=0 で解放、
      TieredPGO=0 / TC_CallCounting=0 / TC_OnStackReplacement=0 では解放されない)。エディターだけの設定 (見本 / ゲームは既定のまま)
    -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
    <!--
      エディターの版 (ED9)。ランチャーが GameEngine.Editor.dll の版を読んで一覧に出す / プロジェクトの ProjectVersion.txt に書く
      版は ../Engine.props の EngineVersion (以前はここの <Version> 0.9.0)。git のコミットは .NET の SDK が InformationalVersion の "+" の後ろに付ける
      Package : 同梱の .NET (SDK) は exe の 1 つ上の dotnet (<エンジン名>_v<版>/dotnet)
    -->
    <AppHostRelativeDotNet>..\dotnet</AppHostRelativeDotNet>
  </PropertyGroup>

  <!-- エンジンの名前 / 版 / アイコン (Package 化で足した) -->
  <Import Project="..\Engine.props" />

  <!--
    スクリプトリファレンス (ED9) : エンジンとエディターのソースを exe に埋め込む (コメントを型の説明として読む)
    ビルドした版のソースなので、説明はいつもその版の物。リポジトリの外 (ランチャーで入れた版) でも読める
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\GameEngine.Runtime\**\*.cs" Exclude="..\GameEngine.Runtime\obj\**;..\GameEngine.Runtime\bin\**" LogicalName="RuntimeSource/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
    <EmbeddedResource Include="**\*.cs" Exclude="obj\**;bin\**" LogicalName="EditorSource/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <Import Project="..\NativeEngine.targets" />

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameEngine.Runtime\GameEngine.Runtime.csproj" />
  </ItemGroup>

</Project>
