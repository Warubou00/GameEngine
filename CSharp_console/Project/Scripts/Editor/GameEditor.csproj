<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ==========================================================================
    ゲームのエディターの拡張 (ED7 後半。Unity の Editor フォルダに当たる)
      - [CustomEditor] / [EditorWindow] / [MenuItem] / [AssetImporter] をここに書く (GameEngine.Editor の EditorExtensions.cs)
      - エディターは Game.csproj の代わりにこのプロジェクトをビルドし (Game も一緒にビルドされる)、GameEditor.dll も読み込む
      - ゲーム (Game.dll) はこのプロジェクトを参照しない (出来上がったゲームにエディターの物が入らないように)
      - EditorAssemblyDir : 参照するエディターの GameEngine.Editor.dll / ImGui.NET.dll の場所 (エディターがビルドする時に渡す。
        IDE で開いた時は既定の Release の出力)
      - エンジン (GameEngine.Runtime) : リポジトリの中は csproj を、外 (Package) は EngineAssemblyDir の DLL を参照する (Game.csproj と同じ)
    ==========================================================================
  -->
  <!-- Visual Studio などでビルドする時の、エンジン / エディターの DLL の場所 (エディターが書く。v1.1。下の既定より先に) -->
  <Import Project="..\..\Library\EngineReferences.props" Condition="Exists('..\..\Library\EngineReferences.props')" />

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <AssemblyName>GameEditor</AssemblyName>
    <RootNamespace>GameEngine_console.Editor</RootNamespace>
    <EditorAssemblyDir Condition="'$(EditorAssemblyDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\GameEngine.Editor\bin\x64\Release\net9.0-windows\</EditorAssemblyDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Game.csproj" />
    <Reference Include="GameEngine.Editor">
      <HintPath>$(EditorAssemblyDir)GameEngine.Editor.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ImGui.NET">
      <HintPath>$(EditorAssemblyDir)ImGui.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Assets の Editor フォルダの .cs (v1.1。Unity の Editor フォルダと同じ) -->
  <ItemGroup>
    <Compile Include="..\..\Assets\**\Editor\**\*.cs" LinkBase="Assets" />
  </ItemGroup>

  <PropertyGroup>
    <EngineRuntimeProject>$(MSBuildThisFileDirectory)..\..\..\GameEngine.Runtime\GameEngine.Runtime.csproj</EngineRuntimeProject>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(EngineRuntimeProject)')">
    <ProjectReference Include="$(EngineRuntimeProject)" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(EngineRuntimeProject)')">
    <Reference Include="GameEngine.Runtime">
      <HintPath>$(EngineAssemblyDir)GameEngine.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
