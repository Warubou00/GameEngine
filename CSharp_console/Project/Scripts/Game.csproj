<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ==========================================================================
    ゲームのコード (ED7)。自分のコンポーネント (IComponent の struct) と System ([GameSystem]) をここに書く
      - エディターはこのプロジェクトをビルドし (dotnet build)、できた Game.dll を読み込む。
        .cs を保存すると、ビルドし直して読み直す (エディターを閉じなくてよい。シーンの値は引き継ぐ)
      - 見本 (GameEngine_console) もこのプロジェクトを参照して、同じコードで動く
      - 名前空間は GameEngine_console のまま (シーンのファイルの型の名前を変えないため)
    ==========================================================================
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <AssemblyName>Game</AssemblyName>
    <RootNamespace>GameEngine_console</RootNamespace>
  </PropertyGroup>

  <!-- エディターの拡張 (Editor フォルダ) はゲームに入れない (別のプロジェクト GameEditor.csproj。ED7) -->
  <ItemGroup>
    <Compile Remove="Editor\**" />
    <None Remove="Editor\**" />
  </ItemGroup>

  <!--
    エンジンは参照するだけ (写さない : エディター / 見本が読み込んだ物を使う)
      リポジトリの中 : GameEngine.Runtime.csproj を参照する
      リポジトリの外 (Package のプロジェクト) : エディターが渡す EngineAssemblyDir (エディターの exe のフォルダ) の GameEngine.Runtime.dll を参照する
      (以前はいつも ..\..\GameEngine.Runtime を参照していたので、リポジトリの外ではビルドできなかった)
  -->
  <PropertyGroup>
    <EngineRuntimeProject>$(MSBuildThisFileDirectory)..\..\GameEngine.Runtime\GameEngine.Runtime.csproj</EngineRuntimeProject>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(EngineRuntimeProject)')">
    <ProjectReference Include="$(EngineRuntimeProject)" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(EngineRuntimeProject)')">
    <Reference Include="GameEngine.Runtime">
      <HintPath>$(EngineAssemblyDir)GameEngine.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
