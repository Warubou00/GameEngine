<Project>

  <!--
    ==========================================================================
    エンジンの名前 / 版 / アイコン (ランチャー / エディター / Player / Runtime の共通。Package 化で足した)
      - 名前 (Product) は exe のファイルの説明と、窓のタイトル (Runtime の EngineInfo.Name が読む) に使う
      - exe / DLL のファイル名 (GameEngine.Editor.exe など) はコードが参照しているので変えない
      - 版を上げる時はここの EngineVersion を変える (以前はエディター / ランチャーの csproj の <Version> にそれぞれ書いていた)
        機能を足すたびに上げる (1.0.0.0 : Package 化 / 1.1.0.0 : スクリプトの作成と sln / アセットの削除 / カメラのズーム /
         1.2.0.0 : Behaviour<T> の GetComponent と OnCollisionEnter / Stay / Exit /
         1.3.0.0 : 新しいプロジェクト / Data.pak / exe のアイコン / ドラッグで動かす / 日本語の入力 /
         1.4.0.0 : Behaviour の Awake / Start / FixedUpdate / LateUpdate、既定の空 (Skybox) /
         1.5.0.0 : 1 Mesh / 1 Material (マテリアルの自動生成)、物ごとの影、シェーダーの雛形、複数のカメラ /
         1.6.0.0 : エクスプローラーからのドラッグ & ドロップ、Stop で音を止める、AudioSource のコピーからの Play /
         1.7.0.0 : UI (Widget アセット / UMG 相当の部品 / Widget Designer / シーンの UIWidget) /
         1.8.0.0 : 後ろにある間 / 最小化中は止める (Run In Background)、クラッシュレポートの自動作成 /
         1.9.0.0 : コリジョンアセット (.collision.json / CompoundCollider / コリジョンの窓 / 部品ごとの衝突のメソッド) /
         1.10.0.0 : プロファイラーの窓を分ける (Profiler / CPU / GPU / Rendering / Memory)、クリックのすり抜けを直す、CPU の区間 (Profiler.BeginSample) /
         1.11.0.0 : 描画パスの区切り (BeginPass) / パスごとの GPU・CPU の時間 / PIX のイベント / RenderTexture の名前 /
         1.12.0.0 : Render Graph Viewer (パス × リソースの読み書き / バリア / 寿命 / 中身)、レンダーターゲットごとの GPU のメモリ /
         1.13.0.0 : Frame Debugger (描画をイベントごとに止めて描画先を見る / 物を Hierarchy で選ぶ) /
         1.13.1.0 : Render Graph Viewer の Live のチラつきを直す (間隔ごとに、形が変わった時だけ差し替える) /
         1.14.0.0 : シーンの管理 S1 (SceneManager : シーンの切り替え / 足す / サブシーン (SubScene) / DontDestroyOnLoad) /
         1.15.0.0 : シーンの管理 S2 (非同期の読み込み LoadSceneAsync / LoadSubSceneAsync / SceneOperation、ロード画面の見本) /
         1.16.0.0 : シーンの管理 S3 (エディター : Hierarchy のシーン分け / サブシーンの中は見るだけ / SubScene のボタン / シーンをドラッグして置く) /
         1.17.0.0 : シーンの管理 S4 (モデルを別のスレッドで読む : C++ の解析 + テクスチャのデコードをワーカーへ、GPU への登録だけメイン) /
         1.18.0.0 : GameObject (GO1 : GameObject の窓口 / 名前・タグ・Id・型で速く探す / タグ) /
         1.19.0.0 : GameObject GO2 (Inspector の物の欄 : Hierarchy から落とす / Ping / 検索つきの選ぶ窓 / 別のシーンの物を断る) /
         1.20.0.0 : GameObject GO3 (ComponentRef<T> / Prefab・SceneReference のフィールド / アセットの欄の表と選ぶ窓) /
         1.21.0.0 : GameObject GO4 (見本 objects_demo / 書き出したゲームとホットリロードの確認 / 選ぶ窓の重さ) /
         1.22.0.0 : UserData UD1 (ScriptableObject 相当 : .userdata.json / 読み込み・保存・読み直し / コンポーネントのフィールド。v2.0.0.0 への途中) /
         1.23.0.0 : UserData UD2 (エディター : Create > UserData / Inspector で編集・元に戻す / 同じ型だけの選ぶ窓 / 再生を止めるとファイルの値に戻す) /
         2.0.0.0 : UserData UD3 (書き出したゲームは .userdata.bin (詰めて混ぜ、書き換えを確かめる) / 見本 userdata_demo / ドキュメント) /
         2.1.0.0 : 前に開いていたシーンを開く / 窓の並びのプリセット (Default + 5 つ。日本語の名前) / Behaviour があると動いた物が描画されないのを直す /
         2.2.0.0 : スポットライト / 点光源・スポットライトに UE と同じ項目 (光源の半径・減衰の指数・影) / 点光源・スポットライトの影 /
                   クラスターでライトを分ける (多いライトが軽い) / GameObject > Light とシーンビューのライトの印・範囲 / エディターのスプラッシュ画面 /
         2.3.0.0 : 画像エディター (Project の画像をダブルクリック。PNG / JPEG / BMP / TGA を自前で読み書き / 色のフィルター / 画像処理 /
                   周波数フィルター / トーンカーブ / 法線マップ / 輝度表示 / 加工前と比べる / 保存・リセット・Undo / Redo) /
                   GameEngine.Imaging (エンジンに依存しない画像の処理のライブラリ) / Graphics.ReleaseUITexture)
        Package の Editor のフォルダの名前 (TsumugiEngine_v<版>) もこの版
    ==========================================================================
  -->
  <PropertyGroup>
    <EngineName>Tsumugi Engine</EngineName>
    <EngineVersion>2.3.0.0</EngineVersion>
    <Product>$(EngineName)</Product>
    <Version>$(EngineVersion)</Version>
    <ApplicationIcon Condition="'$(OutputType)' != 'Library'">$(MSBuildThisFileDirectory)Branding\TsumugiEngine.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    .NET を入れていない PC で動かす (Package)
      exe (apphost) は、まず exe から見た AppHostRelativeDotNet のフォルダの .NET を使い、無ければ PC に入っている .NET を使う
      AppHostRelativeDotNet は exe ごとに決める (エディター : ../dotnet (同梱の SDK) / ランチャー と Player : dotnet)
      開発の時 (リポジトリのビルド) は同梱の .NET が無いので、今まで通り PC の .NET で動く
  -->
  <PropertyGroup Condition="'$(OutputType)' != 'Library'">
    <AppHostDotNetSearch>AppRelative;Global</AppHostDotNetSearch>
  </PropertyGroup>

  <!--
    .NET の SDK は AppHostDotNetSearch を publish の exe にしか付けない (build の exe は PC の .NET だけを探す)。
    Package / ゲームの書き出しは build の出力を使うので、publish 用の exe を作って build の exe と入れ替える
    (確かめた時に分かった : 入れ替える前は、同梱の dotnet があっても C:\Program Files\dotnet の .NET で動いていた)
  -->
  <Target Name="UseAppRelativeAppHost" AfterTargets="Build"
          DependsOnTargets="_GetAppHostPaths;_GetAppHostCreationConfiguration;_CreateAppHostForPublish"
          Condition="'$(OutputType)' != 'Library' and '$(UseAppHost)' != 'false'">
    <Copy SourceFiles="$(AppHostForPublishIntermediatePath)" DestinationFiles="$(OutDir)$(AssemblyName)$(_NativeExecutableExtension)"
          SkipUnchangedFiles="true" Condition="Exists('$(AppHostForPublishIntermediatePath)')" />
  </Target>

</Project>
