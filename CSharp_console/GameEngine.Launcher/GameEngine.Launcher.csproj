<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ==========================================================================
    ランチャー (ED9)。プロジェクトとエディターの版を選んで、エディターを起動する
      - エディターの版 : リポジトリのビルド (開発版) / ランチャーで入れた版 (%LOCALAPPDATA%\GameEngine\Editors) / 手で足した exe
      - エンジン (D3D12) は使わない (WinForms だけ。すぐ開く)。エディターとは別の exe なので、どの版のエディターでも起動できる
    ==========================================================================
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <RootNamespace>GameEngine.Launcher</RootNamespace>
    <AssemblyName>GameEngine.Launcher</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Package : 同梱の .NET (動かすだけの物) は exe の隣の dotnet。版は ../Engine.props (以前はここの <Version> 0.9.0) -->
    <AppHostRelativeDotNet>dotnet</AppHostRelativeDotNet>
  </PropertyGroup>

  <!-- 新しいプロジェクトの csproj の雛形 (v1.3)。見本のプロジェクトの物をそのまま埋め込む -->
  <ItemGroup>
    <EmbeddedResource Include="..\Project\Scripts\Game.csproj" LogicalName="ProjectTemplate/Game.csproj" Visible="false" />
    <EmbeddedResource Include="..\Project\Scripts\Editor\GameEditor.csproj" LogicalName="ProjectTemplate/GameEditor.csproj" Visible="false" />
  </ItemGroup>

  <!-- v1.8 : クラッシュレポート。ランチャーは Runtime を参照しないので、ファイルだけ入れる (Core.dll が無いので C# の例外だけ) -->
  <ItemGroup>
    <Compile Include="..\GameEngine.Runtime\CrashReporter.cs" Link="CrashReporter.cs" />
  </ItemGroup>

  <!-- エンジンの名前 / 版 / アイコン (Package 化で足した) -->
  <Import Project="..\Engine.props" />

</Project>
