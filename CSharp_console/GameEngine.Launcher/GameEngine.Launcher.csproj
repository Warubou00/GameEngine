<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ==========================================================================
    ランチャー (ED9)。プロジェクトとエディターの版を選んで、エディターを起動する
      - エディターの版 : リポジトリのビルド (開発版) / ランチャーで入れた版 (%LOCALAPPDATA%\GameEngine\Editors) / 手で足した exe
      - エンジン (D3D12) は使わない (WinForms だけ。すぐ開く)。エディターとは別の exe なので、どの版のエディターでも起動できる
    ==========================================================================
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <RootNamespace>GameEngine.Launcher</RootNamespace>
    <AssemblyName>GameEngine.Launcher</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.9.0</Version>
  </PropertyGroup>

</Project>
