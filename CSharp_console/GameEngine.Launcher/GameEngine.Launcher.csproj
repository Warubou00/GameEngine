<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ==========================================================================
    ランチャー (ED9)。プロジェクトとエディターの版を選んで、エディターを起動する
      - エディターの版 : リポジトリのビルド (開発版) / ランチャーで入れた版 (%LOCALAPPDATA%\GameEngine\Editors) / 手で足した exe
      - エンジン (D3D12) は使わない (WinForms だけ。すぐ開く)。エディターとは別の exe なので、どの版のエディターでも起動できる
    ==========================================================================
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <RootNamespace>GameEngine.Launcher</RootNamespace>
    <AssemblyName>GameEngine.Launcher</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Package : 同梱の .NET (動かすだけの物) は exe の隣の dotnet。版は ../Engine.props (以前はここの <Version> 0.9.0) -->
    <AppHostRelativeDotNet>dotnet</AppHostRelativeDotNet>
  </PropertyGroup>

  <!-- エンジンの名前 / 版 / アイコン (Package 化で足した) -->
  <Import Project="..\Engine.props" />

</Project>
