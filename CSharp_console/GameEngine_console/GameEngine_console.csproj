<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <!--
    ==========================================================================
    C++ 側の成果物を出力フォルダへ自動コピーする
      - DLL (Core / Renderer / RHI) とシェーダーを、ビルドのたびに最新にする
      - 以前は手作業でコピーしていたため、ソースと実行時のファイルがずれていた
      - C++ 側は自動ではビルドされない。先に GameEngine.sln (C++) をビルドしておくこと
    ==========================================================================
  -->
  <PropertyGroup>
    <!-- リポジトリのルート (この csproj から 2 つ上) -->
    <EngineRootDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\'))</EngineRootDir>
    <!-- C# の Debug / Release に合わせて C++ 側の構成を選ぶ -->
    <NativeConfiguration Condition="'$(Configuration)' == 'Release'">Release</NativeConfiguration>
    <NativeConfiguration Condition="'$(NativeConfiguration)' == ''">Debug</NativeConfiguration>
    <!--
      DXC (シェーダーコンパイラ)。Windows 本体には入っていないので Windows SDK のものをコピーする
      Redist\D3D の DXC は古く (10.0.19041)、IDxcUtils に対応していないため、
      SDK 10.0.26100 の bin にある新しい DXC (1.8) を優先する。無い環境では Redist の版 (RHI が FXC に戻す)
    -->
    <DxcRedistDir>$(MSBuildProgramFiles32)\Windows Kits\10\bin\10.0.26100.0\x64\</DxcRedistDir>
    <DxcRedistDir Condition="!Exists('$(DxcRedistDir)dxcompiler.dll')">$(MSBuildProgramFiles32)\Windows Kits\10\Redist\D3D\x64\</DxcRedistDir>
  </PropertyGroup>

  <Target Name="CopyNativeEngineFiles" AfterTargets="Build">
    <ItemGroup>
      <!-- DLL と、デバッグ用の PDB (あれば) -->
      <NativeEngineFile Include="$(EngineRootDir)Core\x64\$(NativeConfiguration)\Core.dll;$(EngineRootDir)Core\x64\$(NativeConfiguration)\Core.pdb" />
      <NativeEngineFile Include="$(EngineRootDir)Renderer\x64\$(NativeConfiguration)\Renderer.dll;$(EngineRootDir)Renderer\x64\$(NativeConfiguration)\Renderer.pdb" />
      <NativeEngineFile Include="$(EngineRootDir)RHI\x64\$(NativeConfiguration)\RHI.dll;$(EngineRootDir)RHI\x64\$(NativeConfiguration)\RHI.pdb" />
      <!-- DXC : dxcompiler.dll (コンパイラ) と dxil.dll (シェーダーの署名)。無い時は RHI が FXC に戻す -->
      <NativeEngineFile Include="$(DxcRedistDir)dxcompiler.dll;$(DxcRedistDir)dxil.dll" />
      <!-- シェーダー : RHI は実行時に "../Shader/" から読むので、出力フォルダの 1 つ上に置く -->
      <EngineShaderFile Include="$(EngineRootDir)RHI\Source\Shader\*.shader" />
    </ItemGroup>

    <!-- DLL が無い = C++ 側をビルドしていない。古い DLL のまま動いてしまわないよう警告を出す -->
    <Warning Condition="!Exists('$(EngineRootDir)RHI\x64\$(NativeConfiguration)\RHI.dll')"
             Text="RHI.dll ($(NativeConfiguration)) が見つかりません。先に C++ 側 (GameEngine.sln) をビルドしてください。" />

    <Copy SourceFiles="@(NativeEngineFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
    <Copy SourceFiles="@(EngineShaderFile)" DestinationFolder="$(OutDir)..\Shader\" SkipUnchangedFiles="true" />

    <Message Importance="high" Text="[Engine] C++ ($(NativeConfiguration)) の DLL とシェーダーを $(OutDir) にコピーしました" />
  </Target>

  <!-- エンジン本体 (ECS / 入力 / カメラ / アセット / C++ の呼び出し)。以前はこのプロジェクトの RHI.cs に全部入っていた -->
  <ItemGroup>
    <ProjectReference Include="..\GameEngine.Runtime\GameEngine.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <COMReference Include="{215d64d2-031c-33c7-96e3-61794cd1ee61}">
      <WrapperTool>tlbimp</WrapperTool>
      <VersionMinor>4</VersionMinor>
      <VersionMajor>2</VersionMajor>
      <Guid>215d64d2-031c-33c7-96e3-61794cd1ee61</Guid>
    </COMReference>
  </ItemGroup>

</Project>
